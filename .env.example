# Todas son opcionales. No hay secretos: el juego no usa cuentas ni base de datos.
PORT=3000            # puerto HTTP/WebSocket (las plataformas PaaS lo inyectan solas)
TIME_SCALE=1         # multiplicador del tiempo de partida (0.5 = mitad) para ajustar la jugabilidad
COUNTDOWN_MS=5000    # cuenta atrás inicial
RECONNECT_MS=60000   # tiempo que se conserva el asiento de un jugador desconectado en la sala de espera
